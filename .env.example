# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Auth
SESSION_COOKIE=sid
SESSION_TTL_DAYS=7

# Google OAuth (leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Integration security (required in production)
INTEGRATION_TOKEN_PEPPER=
SECRETS_ENCRYPTION_KEY=
WA_WEBHOOK_SECRET=

# Local Wajom transport
WA_MOCK=1
WA_MAX_ATTEMPTS=3
WA_RETRY_DELAY_MINUTES=5
WAJOM_REQUEST_TIMEOUT_MS=10000
INTEGRATION_RATE_LIMIT_PER_MINUTE=60

# Public standalone MCP URL (used by exported client configs)
MCP_PUBLIC_URL=http://localhost:3100

# Email notifications (Resend API). Leave empty to skip email in dev.
RESEND_API_KEY=
EMAIL_FROM=Flowboard <no-reply@flowboard.app>
