{
  "name": "web-fullstack-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Full-stack boilerplate: Elysia (API) + SvelteKit + Postgres, served on a single port.",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "vite build",
    "preview": "bun ./server.ts",
    "start": "bun ./server.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run app/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "svelte-kit sync && bun run app/db/seed.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/svelte": "^1.1.4",
    "@lucide/svelte": "^1.31.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.1.24",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "mode-watcher": "^1.1.0",
    "postgres": "^3.4.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.8.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.28.1",
    "svelte": "^5.2.7",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
