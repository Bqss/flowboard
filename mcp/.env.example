# Run the standalone MCP service in production mode.
NODE_ENV=production
FLOWBOARD_MCP_MODE=1

# MCP HTTP listener
MCP_PORT=3100

# Must point to the same PostgreSQL database used by Flowboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Must exactly match Flowboard's INTEGRATION_TOKEN_PEPPER.
# API keys are hashed with this value and cannot be resolved with a different one.
INTEGRATION_TOKEN_PEPPER=

